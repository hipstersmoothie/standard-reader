# ── Database ─────────────────────────────────────────────────────────────────
# Shared Standard Reader database (same DATABASE_URL as the reader). When unset,
# the analytics screens fall back to sample data so the app still runs; once it
# is set, a query failure surfaces instead of silently showing sample data.
DATABASE_URL=
# Optional driver override: "neon" (serverless HTTP) or "pg" (node-postgres pool).
# Auto-detected from the host when unset.
DB_DRIVER=
DB_POOL_MAX=16

# ── App origin & auth ────────────────────────────────────────────────────────
# This app's public origin: used for OAuth client metadata and for building
# unsubscribe / tracking links. On localhost the OAuth client runs in public
# mode and needs no signing key.
PUBLIC_URL=http://127.0.0.1:3100
# In production, a confidential client_assertion signing key (an ES256 private
# JWK, as a JSON string). Leave empty for local public-client development.
ATPROTO_PRIVATE_KEY_JWK=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Resend transactional email — https://resend.com/api-keys
RESEND_API_KEY=
# Resend webhook signing secret ("whsec_..."), from the Resend dashboard webhook
# settings. Required to accept delivery/open/click webhooks — unsigned webhooks
# are rejected.
RESEND_WEBHOOK_SECRET=

# Sender identity (the Resend domain must be verified before sending)
NEWSLETTER_FROM=newsletters@standard.site
NEWSLETTER_FROM_NAME=Standard Newsletter

# ── Permissioned spaces (HappyView) ──────────────────────────────────────────
# Subscriber lists as AT Proto Proposal 0016 permissioned data. When unset, the
# app runs email-only on the DB. See docs/happyview-runbook.md to stand one up.
HAPPYVIEW_URL=
HAPPYVIEW_CLIENT_KEY=
HAPPYVIEW_CLIENT_SECRET=
# Space type NSID; defaults to app.standard-newsletter.list when unset.
HAPPYVIEW_SPACE_TYPE=app.standard-newsletter.list

# Standard Reader deploy that a site's headlines link into. Writer serves the
# standalone site; Reader renders the article.
VITE_READER_URL="http://127.0.0.1:3000"
