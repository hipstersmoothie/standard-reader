# Shared Standard Reader database (same DATABASE_URL as the reader). When unset,
# the analytics screens fall back to sample data so the app still runs.
DATABASE_URL=
# Optional driver override: "neon" (serverless HTTP) or "pg" (node-postgres pool).
DB_DRIVER=
DB_POOL_MAX=16

# Resend transactional email — https://resend.com/api-keys
RESEND_API_KEY=

# Sender identity (Resend domain must be verified)
NEWSLETTER_FROM=newsletters@standard.site
NEWSLETTER_FROM_NAME=Standard Newsletter

# Public origin for unsubscribe / tracking links
PUBLIC_URL=https://newsletter.standard.site
