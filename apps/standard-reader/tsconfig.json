{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["packages/**", "dist/**", ".output/**", "node_modules/**"],
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@standard-reader/db": ["../../packages/db/src/index.ts"],
      "@standard-reader/db/schema": ["../../packages/db/src/schema.ts"],
      "@standard-reader/db/schema/*": ["../../packages/db/src/schema/*"],
      "@standard-reader/design-system/*": [
        "../../packages/design-system/src/*"
      ],
      "@standard-reader/publication-theme": [
        "../../packages/publication-theme/src/index.ts"
      ],
      "@standard-reader/publication-theme/*": [
        "../../packages/publication-theme/src/*.ts"
      ],
      "@standard-reader/site-config": [
        "../../packages/site-config/src/index.ts"
      ],
      "@standard-reader/site-config/*": ["../../packages/site-config/src/*.ts"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
