{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": {
      "#/*": ["../standard-reader/src/*"],
      "@/*": ["../standard-reader/src/*"],
      "@standard-reader/design-system/*": ["../../packages/design-system/src/*"]
    }
  },
  "include": [
    "src/**/*",
    ".wxt/wxt.d.ts",
    "../../packages/design-system/src/**/*",
    "../standard-reader/src/components/reader/theme.ts"
  ],
  "exclude": [
    "../standard-reader/src/routes/**",
    "../standard-reader/src/server/**"
  ]
}
