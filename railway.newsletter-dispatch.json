{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'dispatch runs via tsx against workspace packages built on install; no build step'"
  },
  "deploy": {
    "startCommand": "pnpm --filter standard-newsletter exec tsx scripts/dispatch-sends.ts",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
