{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'reconcile-cron runs TypeScript via tsx; no build step'"
  },
  "deploy": {
    "startCommand": "pnpm reconcile:repos",
    "cronSchedule": "20 * * * *",
    "restartPolicyType": "NEVER"
  }
}
