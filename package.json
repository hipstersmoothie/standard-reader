{
  "name": "standard-reader-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "@huggingface/transformers": "^4.2.0",
      "react": "19.3.0-canary-ad78e251-20260616",
      "react-dom": "19.3.0-canary-ad78e251-20260616",
      "unplugin": "^3.0.0",
      "@tanstack/router-core": "1.171.15"
    }
  },
  "scripts": {
    "dev": "pnpm --filter standard-reader dev",
    "build": "pnpm --filter standard-reader build",
    "start": "pnpm --filter standard-reader start",
    "preview": "pnpm --filter standard-reader preview",
    "test": "pnpm -r --if-present test",
    "perf:discover-fixtures": "pnpm --filter standard-reader perf:discover-fixtures",
    "api-docs:examples": "pnpm --filter standard-reader api-docs:examples",
    "perf:test": "pnpm --filter standard-reader perf:test",
    "perf:test:guest": "pnpm --filter standard-reader perf:test:guest",
    "perf:test:signed-in": "pnpm --filter standard-reader perf:test:signed-in",
    "perf:view": "pnpm --filter standard-reader perf:view",
    "perf:explain": "pnpm --filter standard-reader perf:explain",
    "ingest:dev": "pnpm --filter standard-reader ingest:dev",
    "ingest:start": "pnpm --filter standard-reader ingest:start",
    "digest:send": "pnpm --filter standard-reader digest:send",
    "digest:send:dev": "pnpm --filter standard-reader digest:send:dev",
    "thread:post": "pnpm --filter standard-reader thread:post",
    "thread:post:dev": "pnpm --filter standard-reader thread:post:dev",
    "backfill:actor-handles": "pnpm --filter standard-reader backfill:actor-handles",
    "backfill:search-text": "pnpm --filter standard-reader backfill:search-text",
    "backfill:renderable": "pnpm --filter standard-reader backfill:renderable",
    "backfill:content-formats": "pnpm --filter standard-reader backfill:content-formats",
    "backfill:mochott-articles": "pnpm --filter standard-reader backfill:mochott-articles",
    "backfill:repo-documents": "pnpm --filter standard-reader backfill:repo-documents",
    "backfill:lists": "pnpm --filter standard-reader backfill:lists",
    "scan:unsupported-blocks": "pnpm --filter standard-reader scan:unsupported-blocks",
    "scan:discussion-sources": "pnpm --filter standard-reader scan:discussion-sources",
    "icons:generate": "pnpm --filter standard-reader icons:generate",
    "honeycomb:seed": "pnpm --filter standard-reader honeycomb:seed",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm exec oxlint .",
    "lint:react-compiler": "pnpm --filter standard-reader lint:react-compiler",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "check": "pnpm exec oxfmt && pnpm exec oxlint . --fix",
    "fix-stylex-keys": "pnpm --filter standard-reader fix-stylex-keys",
    "i18n:extract": "pnpm --filter standard-reader i18n:extract",
    "i18n:compile": "pnpm --filter standard-reader i18n:compile",
    "i18n:check": "pnpm --filter standard-reader i18n:check",
    "db:generate": "pnpm --filter standard-reader db:generate",
    "db:migrate": "pnpm --filter standard-reader db:migrate",
    "db:push": "pnpm --filter standard-reader db:push",
    "db:studio": "pnpm --filter standard-reader db:studio",
    "lex:lint": "pnpm --filter standard-reader lex:lint",
    "lex:status": "pnpm --filter standard-reader lex:status",
    "atproto:publish-lexicons": "pnpm --filter standard-reader atproto:publish-lexicons",
    "lexicons:generate": "pnpm --filter @standard-reader/lexicons generate",
    "lexicons:build": "pnpm --filter @standard-reader/lexicons build",
    "packages:build": "pnpm -r --filter \"./packages/**\" run build",
    "packages:publish": "node scripts/publish-packages.mjs",
    "packages:publish:dry": "node scripts/publish-packages.mjs --dry-run",
    "convert": "pnpm --filter @standard-reader/cli exec node dist/bin.js",
    "convert:build": "pnpm --filter @standard-reader/converter --filter @standard-reader/cli run build",
    "extension:dev": "pnpm --filter standard-reader-extension dev",
    "extension:build": "pnpm --filter standard-reader-extension build",
    "extension:zip": "pnpm --filter standard-reader-extension zip",
    "extension:build:firefox": "pnpm --filter standard-reader-extension build:firefox",
    "extension:zip:firefox": "pnpm --filter standard-reader-extension zip:firefox",
    "register-labelers": "pnpm --filter standard-reader register-labelers",
    "sync-labels": "pnpm --filter standard-reader sync-labels",
    "feedback:poll": "pnpm --filter standard-reader feedback:poll",
    "feedback:poll:dev": "pnpm --filter standard-reader feedback:poll:dev",
    "feedback:status": "pnpm --filter standard-reader feedback:status",
    "feedback:status:dev": "pnpm --filter standard-reader feedback:status:dev",
    "fonts:generate": "pnpm --filter standard-reader fonts:generate"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "oxfmt": "latest",
    "oxlint": "1.48.0"
  }
}
