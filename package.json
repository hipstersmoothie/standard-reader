{
  "name": "standard-reader-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "@huggingface/transformers": "^4.2.0",
      "react": "19.3.0-canary-ad78e251-20260616",
      "react-dom": "19.3.0-canary-ad78e251-20260616",
      "unplugin": "^3.0.0",
      "@tanstack/router-core": "1.171.15"
    }
  },
  "scripts": {
    "build": "pnpm --filter standard-reader build",
    "start": "pnpm --filter standard-reader start",
    "dev": "pnpm --filter standard-reader dev",
    "preview": "pnpm --filter standard-reader preview",
    "newsletter:dev": "pnpm --filter standard-newsletter dev",
    "newsletter:build": "pnpm --filter standard-newsletter build",
    "newsletter:start": "pnpm --filter standard-newsletter start",
    "newsletter:send": "pnpm --filter standard-newsletter newsletter:send",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm exec oxlint .",
    "lint:react-compiler": "pnpm --filter standard-reader lint:react-compiler",
    "format": "pnpm exec oxfmt",
    "format:check": "pnpm exec oxfmt --check",
    "check": "pnpm exec oxfmt && pnpm exec oxlint . --fix",
    "db:generate": "pnpm --filter standard-reader db:generate",
    "db:migrate": "pnpm --filter standard-reader db:migrate",
    "db:push": "pnpm --filter standard-reader db:push",
    "db:studio": "pnpm --filter standard-reader db:studio",
    "ingest:start": "pnpm --filter standard-reader ingest:start",
    "ingest:dev": "pnpm --filter standard-reader ingest:dev",
    "digest:send": "pnpm --filter standard-reader digest:send",
    "thread:post": "pnpm --filter standard-reader thread:post",
    "lex:lint": "pnpm --filter standard-reader lex:lint",
    "lex:status": "pnpm --filter standard-reader lex:status",
    "atproto:publish-lexicons": "pnpm --filter standard-reader atproto:publish-lexicons",
    "lexicons:generate": "pnpm --filter @standard-reader/lexicons generate",
    "lexicons:build": "pnpm --filter @standard-reader/lexicons build",
    "packages:build": "pnpm -r --filter \"./packages/**\" run build",
    "i18n:extract": "pnpm --filter standard-reader i18n:extract",
    "i18n:compile": "pnpm --filter standard-reader i18n:compile",
    "i18n:check": "pnpm --filter standard-reader i18n:check",
    "extension:dev": "pnpm --filter standard-reader-extension dev",
    "extension:build": "pnpm --filter standard-reader-extension build"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "oxfmt": "latest",
    "oxlint": "1.48.0"
  }
}
