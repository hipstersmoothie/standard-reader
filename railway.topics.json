{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'topics-cron runs TypeScript via tsx; no build step'"
  },
  "deploy": {
    "startCommand": "pnpm topics:cron",
    "cronSchedule": "0 4 * * *",
    "restartPolicyType": "NEVER"
  }
}
