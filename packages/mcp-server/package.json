{
  "name": "@standard-reader/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Standard Reader XRPC API — read and write a reader's AT Protocol reading state from any MCP client.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "standard-reader-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "standard-reader",
    "atproto",
    "mcp",
    "model-context-protocol",
    "xrpc",
    "reader"
  ],
  "dependencies": {
    "@atcute/password-session": "^1.0.1",
    "@atproto/lex-client": "^0.3.0",
    "@atproto/lex-schema": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@standard-reader/lexicons": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
